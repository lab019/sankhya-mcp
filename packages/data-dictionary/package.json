{
  "name": "@sankhya-mcp/data-dictionary",
  "version": "0.1.0",
  "description": "Dicionário de dados: mapeamento entidade↔tabela, chaves primárias e campos conhecidos da API Sankhya",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "8.3.1",
    "vitest": "^4.1.11"
  }
}
