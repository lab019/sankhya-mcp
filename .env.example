# =============================================================================
# Sankhya MCP — variáveis de ambiente
# Copie para `.env` (NUNCA commite o `.env`) ou exporte no ambiente do servidor.
# As credenciais ficam SOMENTE no servidor; nunca são expostas ao LLM.
# =============================================================================

# --- Credenciais OAuth 2.0 (Client Credentials) — OBRIGATÓRIAS -----------------
SANKHYA_CLIENT_ID=
SANKHYA_CLIENT_SECRET=
SANKHYA_X_TOKEN=

# --- Ambiente ------------------------------------------------------------------
# "sandbox" (default, seguro) ou "production".
# Produção exige opt-in explícito.
SANKHYA_ENV=sandbox

# --- Modos de segurança --------------------------------------------------------
# Bloqueia QUALQUER operação de escrita (save_record etc.).
SANKHYA_READ_ONLY=false

# Operações de escrita apenas mostram o payload que SERIA enviado (não executam).
SANKHYA_DRY_RUN=false

# Habilita a tool perigosa de SQL livre (DbExplorerSP.executeQuery).
# Deixe "false" salvo se você entende plenamente os riscos.
SANKHYA_ALLOW_RAW_SQL=false

# --- Ajustes opcionais ---------------------------------------------------------
# Sobrescreve a base URL (debug/proxy). Normalmente derivada de SANKHYA_ENV.
# SANKHYA_BASE_URL=

# Segundos de folga para renovar o token antes de expirar (default 60).
# SANKHYA_TOKEN_REFRESH_SKEW=60

# Timeout das requisições HTTP em ms (default 30000).
# SANKHYA_HTTP_TIMEOUT=30000
